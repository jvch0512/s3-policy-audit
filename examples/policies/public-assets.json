{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "PublicRead", "Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::acme-public-assets/*" },
    { "Sid": "UploadFromAnywhere", "Effect": "Allow", "Principal": { "AWS": "*" }, "Action": ["s3:PutObject", "s3:PutObjectAcl"], "Resource": "arn:aws:s3:::acme-public-assets/uploads/*" },
    { "Sid": "ReleaseTeam", "Effect": "Allow", "Principal": { "AWS": "arn:aws:iam::111122223333:role/release" }, "Action": "s3:*", "Resource": "*" }
  ]
}
